# Секреты бэкенда Splitty. Скопируй в .env РЯДОМ с docker-compose.yml на сервере
# и заполни значения. Реальный .env в git не коммитится (см. .gitignore);
# docker-compose и `make deploy` (через `. ./.env`) подхватывают его сами.
#
# ⚠️ Одного .env НЕ ДОСТАТОЧНО: `make deploy` разворачивает файл в окружение
# ХОСТА, а compose пробрасывает в контейнер только переменные, перечисленные
# поимённо в docker-compose.yml (services.telegram-bot.environment). Новая
# переменная добавляется В ДВА МЕСТА — сюда и туда.

# Telegram-бот (токен от BotFather). Пусто — бот выключен, REST работает.
TG_TOKEN=

# Секрет подписи JWT (HS256), ОБЯЗАТЕЛЕН. Сгенерировать: openssl rand -hex 32
# НЕ менять на живом сервере — инвалидирует все выданные токены (разлогинит всех).
API_JWT_SECRET=

# Google Gemini (AI-распознавание расхода). Пусто — /parse отдаёт 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Ревью App Store ---
# Многоразовый код входа для ревьюеров (обычный вход требует Telegram) и НОМЕР
# SPLITTY (_id, не telegram id) демо-аккаунта. Пустой код — механизм выключен.
# Демо-аккаунт защищён от удаления через DELETE /me (403).
REVIEW_LOGIN_CODE=
REVIEW_USER_ID=

# --- Вход через Google/Apple ---
# Пусто — соответствующий эндпоинт отдаёт 503, остальной сервер работает.

# Допустимые aud токенов Google, разделитель ":". Кладутся iOS- и серверный
# (Web) client id. Android-клиенты СЮДА НЕ ИДУТ: Credential Manager выпускает
# токен с aud серверного client id.
GOOGLE_CLIENT_IDS=

# Client id, которым Apple выпускает ID-токены, разделитель ":".
# ⚠️ ПЕРВЫМ обязан идти bundle id приложения: именно clientIDs[0] подставляется
# в client_secret при обмене authorizationCode и отзыве токенов. Services ID,
# поставленный первым, молча ломает и обмен, и отзыв.
APPLE_CLIENT_IDS=

# Team ID и Key ID ключа Sign in with Apple.
APPLE_TEAM_ID=
APPLE_KEY_ID=

# СОДЕРЖИМОЕ файла .p8 (не путь!). Ключ многострочный, а .env читается через
# `set -a && . ./.env`, поэтому значение ОБЯЗАНО быть в кавычках:
#   APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...
#   -----END PRIVATE KEY-----"
# Допустима и однострочная форма с \n — парсер их разворачивает.
# Пусто — вход через Apple работает, а обмен кода и отзыв токенов нет (warning
# в лог). Для App Store Guideline 5.1.1(v) отзыв обязателен.
# ⚠️ .p8 и его содержимое в git не коммитятся НИКОГДА.
APPLE_PRIVATE_KEY=

# --- Диплинк-вход в группу ---
# Публичный https-адрес сервера. ПУСТО — вся фича выключена: /join и оба
# .well-known отдают 404, а inviteUrl не приезжает клиентам (они показывают
# старую ссылку через бота). Домен ещё не куплен — это штатное состояние.
# ⚠️ Включение НЕ ограничивается сервером: домен ещё прописывается в
# android:host (AndroidManifest.xml), applinks: (ios/project.yml и
# ios/Splitty/Splitty.entitlements) — и оба клиента пересобираются.
PUBLIC_BASE_URL=

# <TeamID>.<bundle id>, например K8922Y6R3M.com.zagir.splitty.
# Пусто — apple-app-site-association отдаёт 404 (пустой appID хуже отсутствия
# файла: iOS закеширует негодную ассоциацию домена).
IOS_APP_ID=

# Имя пакета Android, например com.zagir.splitty. Используется в assetlinks.json
# и в ссылке на карточку Google Play.
ANDROID_PACKAGE=

# SHA-256 отпечатки сертификатов подписи для assetlinks.json.
# ⚠️ Разделитель ЗАПЯТАЯ, а не привычный ":" — сам отпечаток состоит из байтов
# через двоеточие. Отпечатков обычно два: Play App Signing и локальный
# debug-ключ (иначе app links не верифицируются в отладочной сборке).
# Пусто — assetlinks.json отдаёт 404.
ANDROID_CERT_SHA256=

# Карточка приложения в App Store для страницы приглашения. Числовой id
# появляется только после первой публикации, вывести его из bundle id нельзя.
# Пусто — кнопка App Store на странице не рисуется.
IOS_STORE_URL=

# --- Прочее ---
# Сколько обратных прокси стоит ПЕРЕД сервером. 0 (дефолт, текущий деплой —
# контейнер публикует порт напрямую) означает «X-Forwarded-For не читать»:
# заголовок пишет кто угодно, и любой per-IP лимит обходился бы случайным
# значением на каждый запрос. Поставить 1, когда перед сервером появится
# TLS-терминатор (он же появится вместе с PUBLIC_BASE_URL).
TRUSTED_PROXY_COUNT=0

# FCM push уже настроен в docker-compose.yml (FIREBASE_CREDENTIALS_FILE +
# монтирование firebase-service-account.json). Сам JSON-файл положи рядом с
# docker-compose.yml (make push-secret) — в git он не коммитится.
