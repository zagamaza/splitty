<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Native-пуши (FCM); на Android 13+ требуется runtime-разрешение. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Фото чека камерой (AI-распознавание); камера не обязательна для установки. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Голосовой ввод расхода (hold-to-talk); микрофон не обязателен для установки. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SplittyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Splitty">

        <!-- configChanges убран: Compose переживает пересоздание Activity через
             rememberSaveable/ViewModel, а ручной перехват мешал predictive back. -->
        <!-- launchMode=singleTop обязателен для диплинков: по умолчанию (standard)
             переход по ссылке при ЖИВОМ приложении создал бы ВТОРОЙ экземпляр
             Activity и позвал onCreate вместо onNewIntent — в стеке оказались бы
             два приложения, а состояние первого потерялось бы. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App link приглашения в группу: https://<domain>/join/<roomId>
                 (страницу отдаёт бэкенд, internal/rest/deeplink.go).
                 autoVerify=true — система сама скачивает /.well-known/assetlinks.json
                 и, если package name и SHA-256 подписи сошлись, открывает ссылку
                 сразу в приложении, без листа выбора браузера.
                 TODO: домен splitty.app ещё НЕ куплен — это плейсхолдер, он обязан
                 совпасть с PUBLIC_BASE_URL бэкенда и с applinks: в ios/project.yml.
                 До покупки домена верификация не пройдёт, и диплинк работает только
                 через схему splitty:// из фильтра ниже. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="splitty.app"
                    android:pathPrefix="/join" />
            </intent-filter>

            <!-- Кастомная схема splitty://join/<roomId> — кнопка «Открыть в
                 приложении» на странице /join (defaultAppScheme в deeplink.go).
                 Отдельный фильтр: autoVerify относится только к https, схему
                 верифицировать нечем. Это единственный работающий канал диплинка
                 ДО покупки домена. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="splitty"
                    android:host="join" />
            </intent-filter>
        </activity>

        <!-- content-Uri для файла камеры (TakePicture): без внешних прав хранилища. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Приём FCM-пушей. -->
        <service
            android:name=".push.SplittyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Канал для фоновых notification-пушей (когда трей рисует система). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="operations" />
    </application>

</manifest>
