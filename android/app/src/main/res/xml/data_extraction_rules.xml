<?xml version="1.0" encoding="utf-8"?>
<!-- Автобэкап (API 31+). Исключаем секреты и офлайн-очередь ТОЧНЫМИ путями:
     шифротекст токена без Keystore-ключа (ключ не покидает устройство) не
     восстановим — бэкапить его бессмысленно и вредно; outbox и кеш API —
     локальное производное состояние, восстановление на другом устройстве
     под другим пользователем недопустимо. vosk-model-ru — распакованная модель
     распознавания (~40-50 МБ): она одна выбивает квоту автобэкапа (~25 МБ), и
     тогда молча перестаёт бэкапиться ВСЁ остальное; скачивается заново по
     требованию. Пути относительны filesDir. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Каталог целиком: DataStore пишет через session.preferences_pb.tmp,
             и точечное исключение одного файла выпускало шифротекст токена
             в бэкап во временном файле. -->
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="outbox.json" />
        <exclude domain="file" path="cache-api/" />
        <exclude domain="file" path="vosk-model-ru/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="outbox.json" />
        <exclude domain="file" path="cache-api/" />
        <exclude domain="file" path="vosk-model-ru/" />
    </device-transfer>
</data-extraction-rules>
