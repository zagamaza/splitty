<?xml version="1.0" encoding="utf-8"?>
<!-- fullBackupContent (API ≤30). Те же исключения, что и в
     data_extraction_rules.xml: секреты/очередь/кеш не бэкапим.
     vosk-model-ru — распакованная модель распознавания (~40-50 МБ): одна она
     выбивает квоту автобэкапа (~25 МБ), и тогда молча перестаёт бэкапиться ВСЁ
     остальное. Скачивается заново по требованию. -->
<full-backup-content>
    <!-- Каталог целиком: DataStore пишет через .tmp, и точечное исключение
         одного файла выпускало шифротекст токена в бэкап во временном файле. -->
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="outbox.json" />
    <exclude domain="file" path="cache-api/" />
    <exclude domain="file" path="vosk-model-ru/" />
</full-backup-content>
