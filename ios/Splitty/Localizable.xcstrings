    "Пригласить можно того, с кем у вас уже была общая группа. Остальным отправьте ссылку": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladen kannst du, mit wem du schon eine Gruppe geteilt hast. Allen anderen schick einen Link"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can invite someone you’ve already shared a group with. Send everyone else a link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes invitar a alguien con quien ya compartiste grupo. A los demás envíales un enlace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez inviter quelqu’un avec qui vous avez déjà partagé un groupe. Envoyez un lien aux autres"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пригласить можно того, с кем у вас уже была общая группа. Остальным отправьте ссылку"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに同じグループにいた人を招待できます。ほかの人にはリンクを送ってください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以邀请已经同群的人。其他人请发送链接"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 같은 그룹에 있던 분을 초대할 수 있습니다. 다른 분께는 링크를 보내 주십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para convidar quem já esteve em um grupo com você. Aos demais, mande um link"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi invitare chi ha già condiviso un gruppo con te. Agli altri manda un link"
          }
        }
      }
    },
    "Приглашение": {
