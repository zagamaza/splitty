    "Впишите точную сумму за человека. Пустое поле — «авто»: остаток делится поровну": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag den genauen Betrag pro Person ein. Ein leeres Feld bedeutet „auto“: der Rest wird gleichmäßig geteilt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the exact amount per person. An empty field means “auto”: the rest is split equally"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el importe exacto por persona. Un campo vacío es «auto»: el resto se reparte a partes iguales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le montant exact par personne. Un champ vide vaut « auto » : le reste est réparti à parts égales"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите точную сумму за человека. Пустое поле — «авто»: остаток делится поровну"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1人あたりの金額を入力してください。空欄は「自動」で、残りが均等に分割されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入每人的准确金额。留空表示「自动」：剩余金额平摊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1인당 정확한 금액을 입력해 주십시오. 비워 두면 「자동」으로 나머지가 균등하게 분배됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o valor exato por pessoa. Campo vazio significa “automático”: o resto é dividido igualmente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l’importo esatto a persona. Campo vuoto significa “automatico”: il resto viene diviso in parti uguali"
          }
        }
      }
    },
