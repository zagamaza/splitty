    "Расход изменил кто-то другой. Откройте его заново и повторите правку": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes hat diese Ausgabe geändert. Öffne sie erneut und wiederhole deine Änderung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else changed this expense. Open it again and redo your edit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona cambió este gasto. Ábrelo de nuevo y repite tu edición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre a modifié cette dépense. Rouvrez-la et refaites votre modification"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход изменил кто-то другой. Откройте его заново и повторите правку"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支出は他の人が変更しました。開き直してから編集をやり直してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这笔支出已被其他人修改。请重新打开后再编辑"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 이 지출을 변경했습니다. 다시 열어 편집해 주십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa alterou esta despesa. Abra de novo e refaça a sua edição"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcun altro ha modificato questa spesa. Riaprila e rifai la tua modifica"
          }
        }
      }
    },
    "Расход переименовали или добавили фото — сумма и ваша доля не изменились": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe wurde umbenannt oder ein Foto hinzugefügt — Betrag und dein Anteil bleiben gleich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense was renamed or a photo was added — the amount and your share didn’t change"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renombró un gasto o se añadió una foto: el importe y tu parte no cambian"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense a été renommée ou une photo ajoutée — le montant et votre part n’ont pas changé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход переименовали или добавили фото — сумма и ваша доля не изменились"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出の名称が変更されたか、写真が追加されました。金額とあなたの負担分は変わっていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出被改名或添加了照片 — 金额和你的分摊没有变化"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출 이름이 바뀌었거나 사진이 추가되었습니다. 금액과 회원님의 몫은 변하지 않았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa foi renomeada ou ganhou uma foto — o valor e a sua parte não mudaram"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una spesa è stata rinominata o ha ricevuto una foto: l’importo e la tua quota non sono cambiati"
          }
        }
      }
    },
