    "Оплата прошла, но подтвердить её пока не удалось. Проверьте связь — доступ появится сам": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment went through, but we couldn’t confirm it yet. Check your connection — access will appear on its own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se realizó, pero aún no pudimos confirmarlo. Revisa la conexión: el acceso aparecerá solo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung ist erfolgt, konnte aber noch nicht bestätigt werden. Verbindung prüfen — der Zugang erscheint von selbst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est passé, mais nous n’avons pas encore pu le confirmer. Vérifiez la connexion : l’accès apparaîtra tout seul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата прошла, но подтвердить её пока не удалось. Проверьте связь — доступ появится сам"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いは完了しましたが、まだ確認できていません。接続を確認してください。アクセスは自動的に有効になります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款已完成，但暂时无法确认。请检查网络 — 权限会自动开通"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 완료되었으나 아직 확인하지 못했습니다. 연결을 확인해 주십시오. 이용 권한은 자동으로 활성화됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento foi feito, mas ainda não deu para confirmar. Verifique a conexão — o acesso aparece sozinho"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento è andato a buon fine, ma non siamo ancora riusciti a confermarlo. Controlla la connessione: l’accesso comparirà da solo"
          }
        }
      }
    },
