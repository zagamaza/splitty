    "Ваша доля 300 ₽ уходит одним переводом, а не двумя: Splitty сводит долги внутри группы.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anteil von 3,00 € geht als eine Überweisung statt zweier: Splitty verrechnet die Schulden innerhalb der Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your $3.00 share goes out as one transfer instead of two: Splitty nets the debts inside the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu parte de 3,00 € sale en una sola transferencia en vez de dos: Splitty compensa las deudas dentro del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre part de 3,00 € part en un seul virement au lieu de deux : Splitty compense les dettes au sein du groupe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша доля 300 ₽ уходит одним переводом, а не двумя: Splitty сводит долги внутри группы."
          }
        }
      }
    },
