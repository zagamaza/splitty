    "Вас пригласили или добавили в группу": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat dich zu einer Gruppe eingeladen oder hinzugefügt"
