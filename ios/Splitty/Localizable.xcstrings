    "Укажите цену позиции": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Preis für die Position an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a price for the item"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el precio de la línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le prix de la ligne"
          }
        },
        "ru": {
          "stringUnit": {
