    "Ссылка нужна тем, с кем вы ещё не делили расходы.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link ist für Leute, mit denen du noch keine Ausgaben geteilt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link is for people you haven't split expenses with yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace es para quienes aún no han compartido gastos contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien s'adresse à ceux avec qui tu n'as pas encore partagé de dépenses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка нужна тем, с кем вы ещё не делили расходы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは、まだ支出を分けたことのない人のためのものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接是给那些还没和你分摊过支出的人用的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 아직 지출을 나눈 적이 없는 분들을 위한 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link é para quem ainda não dividiu despesas com você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link serve a chi non ha ancora diviso spese con te."
          }
        }
      }
    },
    "Старый пароль перестанет работать, вход по %@ останется доступен после того, как зададите новый.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das alte Passwort funktioniert dann nicht mehr; die Anmeldung mit %@ bleibt möglich, sobald du ein neues gesetzt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old password will stop working; signing in with %@ stays available once you set a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña anterior dejará de funcionar; podrás seguir entrando con %@ en cuanto establezcas una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien mot de passe cessera de fonctionner ; la connexion avec %@ restera possible une fois le nouveau défini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый пароль перестанет работать, вход по %@ останется доступен после того, как зададите новый."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いパスワードは使えなくなります。新しいパスワードを設定すれば、%@ でのサインインは引き続きご利用いただけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密码将失效；设置新密码后仍可使用 %@ 登录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 비밀번호는 사용할 수 없게 됩니다. 새 비밀번호를 설정하시면 %@ 로그인은 계속 이용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha antiga deixa de funcionar; entrar com %@ continua disponível depois que você definir uma nova."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vecchia password smetterà di funzionare; l’accesso con %@ resta disponibile dopo che ne imposti una nuova."
          }
        }
      }
    },
    "Строка исчезнет из чека, итог пересчитается": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile verschwindet vom Beleg, die Summe wird neu berechnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line will disappear from the receipt and the total will be recalculated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea desaparecerá del recibo y el total se recalculará"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne disparaîtra du ticket et le total sera recalculé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка исчезнет из чека, итог пересчитается"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この行はレシートから削除され、合計が再計算されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该行将从小票中删除，合计会重新计算"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 줄은 영수증에서 삭제되고 합계가 다시 계산됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha some do recibo e o total é recalculado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga sparirà dallo scontrino e il totale verrà ricalcolato"
          }
        }
      }
    },
