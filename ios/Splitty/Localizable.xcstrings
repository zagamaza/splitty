            "value": "Jemand anderes hat diese Ausgabe geändert. Öffne sie erneut und wiederhole deine Änderung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else changed this expense. Open it again and redo your edit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona cambió este gasto. Ábrelo de nuevo y repite tu edición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre a modifié cette dépense. Rouvrez-la et refaites votre modification"
