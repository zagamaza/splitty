    "Не то? Зажмите микрофон внизу или добавьте фото чека": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ganz richtig? Halte unten das Mikrofon gedrückt oder füge ein Foto des Belegs hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not quite right? Hold the mic below or add a photo of the receipt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No es del todo correcto? Mantén pulsado el micrófono o añade una foto del recibo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas tout à fait ça ? Maintenez le micro en bas ou ajoutez une photo du ticket"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не то? Зажмите микрофон внизу или добавьте фото чека"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違いましたか？下のマイクを押したままにするか、レシートの写真を追加してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不太对？按住下方麦克风，或添加小票照片"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아닌가요? 아래 마이크를 누르고 계시거나 영수증 사진을 추가해 주십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ficou certo? Segure o microfone abaixo ou adicione uma foto do recibo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è andata? Tieni premuto il microfono qui sotto o aggiungi una foto dello scontrino"
          }
        }
      }
    },
    "Не то? Снимите чек ещё раз или зажмите микрофон внизу": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht richtig? Fotografiere den Beleg erneut oder halte unten das Mikrofon gedrückt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not right? Photograph the receipt again or hold the microphone below"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No es eso? Vuelve a fotografiar el recibo o mantén pulsado el micrófono de abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas ça ? Reprenez le ticket en photo ou maintenez le micro en bas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не то? Снимите чек ещё раз или зажмите микрофон внизу"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違いましたか？レシートを撮り直すか、下のマイクを押したままにしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不对？请重新拍摄小票，或按住下方麦克风"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아닌가요? 영수증을 다시 찍거나 아래 마이크를 누르고 계십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ficou certo? Fotografe o recibo de novo ou segure o microfone abaixo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non va bene? Rifotografa lo scontrino o tieni premuto il microfono qui sotto"
          }
        }
      }
    },
