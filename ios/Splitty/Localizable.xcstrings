    "В валюте группы показываются все её суммы: расходы, долги и итоги.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Beträge der Gruppe werden in ihrer Währung angezeigt: Ausgaben, Schulden und Auswertungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All of the group's amounts are shown in its currency: expenses, debts and totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los importes del grupo se muestran en su moneda: gastos, deudas y totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les montants du groupe sont affichés dans sa devise : dépenses, dettes et bilans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В валюте группы показываются все её суммы: расходы, долги и итоги."
          }
        }
      }
    },
