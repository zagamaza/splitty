    },
    "Ваша доля 300 ₽ уходит одним переводом, а не двумя: Splitty сводит долги внутри группы.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anteil von 3,00 € geht als eine Überweisung statt zweier: Splitty verrechnet die Schulden innerhalb der Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your $3.00 share goes out as one transfer instead of two: Splitty nets the debts inside the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu parte de 3,00 € sale en una sola transferencia en vez de dos: Splitty compensa las deudas dentro del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre part de 3,00 € part en un seul virement au lieu de deux : Splitty compense les dettes au sein du groupe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша доля 300 ₽ уходит одним переводом, а не двумя: Splitty сводит долги внутри группы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの負担分 300円 は2回ではなく1回の送金で済みます。Splitty がグループ内の貸し借りを相殺します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 ¥30.00 只需一次转账，而不是两次：Splitty 会在群组内抵销欠款。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원님의 몫 ₩3,000은 두 번이 아니라 한 번의 송금으로 나갑니다. Splitty가 그룹 내 빚을 상계합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua parte de R$ 30,00 sai em uma transferência, não em duas: o Splitty compensa as dívidas dentro do grupo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua quota di € 3,00 parte con un solo trasferimento invece di due: Splitty compensa i debiti dentro al gruppo."
          }
        }
      }
    },
