    "Бесплатные вернутся через %lld ч. Plus снимает суточный лимит совсем": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатные вернутся через %lld ч. Plus снимает суточный лимит совсем"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free ones are back in %lld h. Plus removes the daily limit entirely"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlosen kommen in %lld Std. zurück. Plus hebt das Tageslimit ganz auf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gratuites reviennent dans %lld h. Plus supprime complètement la limite quotidienne"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gratuitos vuelven en %lld h. Plus elimina el límite diario por completo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelli gratuiti tornano tra %lld h. Plus toglie del tutto il limite giornaliero"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gratuitas voltam em %lld h. O Plus tira o limite diário de vez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料分は %lld 時間後に回復します。Plus なら1日の上限がなくなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 횟수는 %lld시간 뒤에 회복됩니다. Plus를 이용하시면 일일 제한이 사라집니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费次数将在 %lld 小时后恢复。Plus 可完全取消每日上限"
          }
        }
      }
    },
    "Бесплатные скоро вернутся. Plus снимает суточный лимит совсем": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlosen kommen bald zurück. Plus hebt das Tageslimit ganz auf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free ones are back soon. Plus removes the daily limit entirely"
          }
