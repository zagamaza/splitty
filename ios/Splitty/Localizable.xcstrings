    "Укажите цену позиции": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Preis für die Position an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a price for the item"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el precio de la línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le prix de la ligne"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите цену позиции"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "品目の価格を入力してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写该项目的价格"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목의 가격을 입력해 주십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o preço do item"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il prezzo della voce"
          }
        }
      }
    },
    "Укажите цену — коснитесь позиции с меткой «цена?». Или продиктуйте: «пицца стоила 600»": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Preis an — tippe auf die Position mit „Preis?“. Oder sag es einfach: „die Pizza hat 600 gekostet“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a price — tap the item marked “price?”. Or just say it: “the pizza was 600”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un precio: toca la línea marcada con «¿precio?». O dilo en voz alta: «la pizza costó 600»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un prix — touchez la ligne marquée « prix ? ». Ou dictez : « la pizza coûtait 600 »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите цену — коснитесь позиции с меткой «цена?». Или продиктуйте: «пицца стоила 600»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を入力してください。「価格？」と表示された品目をタップします。または「ピザは600円」のようにお話しください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写价格 — 点按标有「价格？」的项目。也可以直接说：「披萨 60 元」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격을 입력해 주십시오. 「가격?」이라고 표시된 항목을 누르십시오. 또는 「피자는 6,000원」처럼 말씀해 주십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o preço — toque no item marcado com “preço?”. Ou diga: “a pizza custou 60”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il prezzo: tocca la voce con l’etichetta “prezzo?”. Oppure dillo: “la pizza costava 6 euro”"
          }
        }
      }
    },
    "Укажите цены позиций — без них не посчитать доли": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Preise für die Positionen an — ohne sie lassen sich die Anteile nicht berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add prices for the items — without them the shares can’t be worked out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica los precios de las líneas: sin ellos no se pueden calcular las partes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez les prix des lignes — sans eux, impossible de calculer les parts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите цены позиций — без них не посчитать доли"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "品目の価格を入力してください。価格がないと取り分を計算できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写各项目的价格 — 否则无法计算份额"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목의 가격을 입력해 주십시오. 가격이 없으면 몫을 계산할 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe os preços dos itens — sem eles não dá para calcular as cotas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica i prezzi delle voci: senza non si possono calcolare le quote"
          }
        }
      }
    },
