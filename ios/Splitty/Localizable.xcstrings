    "Архив скрывает группу из списка только у вас. Операции и долги сохраняются.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Archiv blendet die Gruppe nur bei dir aus. Vorgänge und Schulden bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiving hides the group from your list only. Operations and debts are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar oculta el grupo solo en tu lista. Las operaciones y las deudas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivage retire le groupe de votre liste uniquement. Les opérations et les dettes sont conservées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив скрывает группу из списка только у вас. Операции и долги сохраняются."
          }
        }
      }
    },
