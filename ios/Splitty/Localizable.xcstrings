    "Поделитесь ссылкой или кодом — по нему друг вступит через «Присоединиться».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile den Link oder den Code — damit tritt deine Freundin oder dein Freund über „Beitreten“ bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the link or the code — your friend joins with it via “Join”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte el enlace o el código: con él tu amigo entra desde «Unirse»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez le lien ou le code — votre ami rejoint le groupe avec, via « Rejoindre »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь ссылкой или кодом — по нему друг вступит через «Присоединиться»."
          }
        }
