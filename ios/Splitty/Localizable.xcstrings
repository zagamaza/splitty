    "Splitty делит каждый расход на участников. Ужин 600 на троих — по 200, такси 300 — по 100.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty teilt jede Ausgabe unter den Teilnehmern auf. Abendessen für 6,00 € durch drei sind je 2,00 €, Taxi für 3,00 € je 1,00 €."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty divides every expense among the members. A $6.00 dinner for three is $2.00 each, a $3.00 taxi is $1.00 each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty divide cada gasto entre los participantes. Una cena de 6,00 € entre tres son 2,00 € cada uno; un taxi de 3,00 €, 1,00 € cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty répartit chaque dépense entre les participants. Un dîner à 6,00 € pour trois, c’est 2,00 € chacun ; un taxi à 3,00 €, 1,00 € chacun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty делит каждый расход на участников. Ужин 600 на троих — по 200, такси 300 — по 100."
          }
        }
      }
