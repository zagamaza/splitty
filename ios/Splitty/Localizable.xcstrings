    },
    "Удерживайте микрофон, пока говорите, и отпустите, когда закончите": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Mikrofon gedrückt, während du sprichst, und lass los, wenn du fertig bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the mic while you speak and release when you're done"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el micrófono mientras hablas y suelta al terminar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le micro pendant que vous parlez et relâchez quand vous avez fini"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте микрофон, пока говорите, и отпустите, когда закончите"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している間はマイクを押したままにし、終わったら離してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时按住麦克风，说完后松开"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말씀하시는 동안 마이크를 누르고 계시다가 끝나면 손을 떼십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o microfone enquanto fala e solte quando terminar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il microfono mentre parli e rilascia quando hai finito"
          }
        }
      }
    },
