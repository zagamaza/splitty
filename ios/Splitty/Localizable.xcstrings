    "Старый пароль перестанет работать, вход по %@ останется доступен после того, как зададите новый.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das alte Passwort funktioniert dann nicht mehr; die Anmeldung mit %@ bleibt möglich, sobald du ein neues gesetzt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old password will stop working; signing in with %@ stays available once you set a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña anterior dejará de funcionar; podrás seguir entrando con %@ en cuanto establezcas una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien mot de passe cessera de fonctionner ; la connexion avec %@ restera possible une fois le nouveau défini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый пароль перестанет работать, вход по %@ останется доступен после того, как зададите новый."
          }
        }
      }
    },
