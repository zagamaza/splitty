    "Splitty только записывает: деньги передайте наличными или переводом": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty hält es nur fest: Das Geld übergibst du bar oder per Überweisung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty only records it: hand over the money in cash or by transfer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty solo lo anota: el dinero lo entregas en efectivo o por transferencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty ne fait que l’enregistrer : l’argent se remet en espèces ou par virement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitty только записывает: деньги передайте наличными или переводом"
          }
        }
      }
    },
