    "Подписка продлевается автоматически. Отменить можно в настройках Apple ID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically. Cancel anytime in your Apple ID settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Cancela en los ajustes de tu Apple ID"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Kündigung in den Apple-ID-Einstellungen"
