    "Расходы делятся между участниками — пока в группе только вы, делить не с кем": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben werden unter den Teilnehmern geteilt — solange du allein in der Gruppe bist, gibt es niemanden zum Teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expenses are split between members — while you’re the only one here, there’s no one to split with"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos se reparten entre los participantes: mientras estés solo en el grupo, no hay con quién repartir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses se partagent entre participants — tant que vous êtes seul dans le groupe, il n’y a personne avec qui partager"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходы делятся между участниками — пока в группе только вы, делить не с кем"
          }
        }
      }
    },
