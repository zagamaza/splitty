    "Войти по паролю больше не получится. Адрес останется за аккаунтом.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich dann nicht mehr mit Passwort anmelden. Die Adresse bleibt beim Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be able to sign in with a password any more. The address stays with the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrás entrar con contraseña. El correo seguirá asociado a la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus vous connecter par mot de passe. L’adresse restera liée au compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти по паролю больше не получится. Адрес останется за аккаунтом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードでのサインインはできなくなります。メールアドレスはアカウントに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将无法再使用密码登录。邮箱地址仍会保留在账号中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호로는 더 이상 로그인할 수 없습니다. 이메일 주소는 계정에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não será mais possível entrar com senha. O endereço continua vinculado à conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrai più accedere con la password. L’indirizzo resta associato all’account."
          }
        }
      }
    },
    "Войти через %@ больше не получится. Остальные способы входа продолжат работать.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich dann nicht mehr über %@ anmelden. Die anderen Anmeldemethoden funktionieren weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be able to sign in with %@ any more. Your other sign-in methods will keep working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrás entrar con %@. Las demás formas de entrar seguirán funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus vous connecter via %@. Les autres modes de connexion continueront de fonctionner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти через %@ больше не получится. Остальные способы входа продолжат работать."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でのサインインはできなくなります。他のサインイン方法は引き続き使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将无法再使用 %@ 登录。其他登录方式仍可使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로는 더 이상 로그인할 수 없습니다. 다른 로그인 방법은 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não será mais possível entrar com %@. Os outros métodos continuam funcionando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrai più accedere con %@. Gli altri metodi continueranno a funzionare."
          }
        }
      }
    },
