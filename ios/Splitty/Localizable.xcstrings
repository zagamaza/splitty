    "Оплата прошла, но подтвердить её пока не удалось. Проверьте связь — доступ появится сам": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment went through, but we couldn’t confirm it yet. Check your connection — access will appear on its own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se realizó, pero aún no pudimos confirmarlo. Revisa la conexión: el acceso aparecerá solo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung ist erfolgt, konnte aber noch nicht bestätigt werden. Verbindung prüfen — der Zugang erscheint von selbst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est passé, mais nous n’avons pas encore pu le confirmer. Vérifiez la connexion : l’accès apparaîtra tout seul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата прошла, но подтвердить её пока не удалось. Проверьте связь — доступ появится сам"
          }
        }
      }
    },
