    "%@ за %@. Подписка продлевается автоматически, отменить можно в настройках Apple ID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per %2$@. Renews automatically; cancel anytime in your Apple ID settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Se renueva automáticamente; cancela en los ajustes de tu Apple ID"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pro %2$@. Verlängert sich automatisch, Kündigung in den Apple-ID-Einstellungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par %2$@. Renouvellement automatique, résiliable dans les réglages Apple ID"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ за %@. Подписка продлевается автоматически, отменить можно в настройках Apple ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ あたり %1$@。自動更新されます。解約は Apple ID の設定からいつでも可能です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每%2$@ %1$@。自动续订，可随时在 Apple ID 设置中取消"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@당 %1$@입니다. 자동으로 갱신되며 Apple ID 설정에서 언제든지 해지할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Renova automaticamente; cancele quando quiser nos ajustes do Apple ID"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ogni %2$@. Si rinnova automaticamente; puoi disdire quando vuoi nelle impostazioni dell’ID Apple"
          }
        }
      }
    },
