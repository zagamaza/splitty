    "Поездка, квартира, ужин — кто за что заплатил": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reise, Wohnung, Abendessen — wer hat was bezahlt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip, a flat, a dinner — who paid for what"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje, un piso, una cena: quién pagó qué"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage, un appartement, un dîner — qui a payé quoi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка, квартира, ужин — кто за что заплатил"
          }
        }
      }
    },
    "Поездка, общая квартира или один ужин — всё, что вы с кем-то делите": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reise, eine WG oder ein Abendessen — alles, was du mit jemandem teilst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip, a shared flat or a single dinner — anything you split with someone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje, un piso compartido o una cena: cualquier cosa que compartas con alguien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage, une colocation ou un dîner — tout ce que vous partagez avec quelqu’un"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка, общая квартира или один ужин — всё, что вы с кем-то делите"
          }
        }
      }
    },
    "Поездка, съёмная квартира или один ужин. Платит кто-то один, а расход делят все.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reise, eine Mietwohnung oder ein Abendessen. Einer zahlt, alle teilen sich die Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip, a rented flat or a single dinner. One person pays, everyone shares the expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje, un piso alquilado o una cena. Paga uno y el gasto se reparte entre todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage, un appartement loué ou un dîner. Une personne paie, tout le monde partage la dépense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка, съёмная квартира или один ужин. Платит кто-то один, а расход делят все."
          }
        }
      }
    },
    "Позвать можно того, с кем уже была общая группа. Нового человека — по ссылке или коду приглашения": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladen kannst du, mit wem du schon eine Gruppe geteilt hast. Eine neue Person — per Link oder Einladungscode"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can invite someone you’ve already shared a group with. A new person — by link or invite code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes invitar a alguien con quien ya compartiste grupo. A una persona nueva, por enlace o código de invitación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez inviter quelqu’un avec qui vous avez déjà partagé un groupe. Une nouvelle personne — par lien ou code d’invitation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позвать можно того, с кем уже была общая группа. Нового человека — по ссылке или коду приглашения"
          }
        }
      }
    },
