    "Вы последний участник. Заархивируйте группу, если она больше не нужна": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist das letzte Mitglied. Archiviere die Gruppe, wenn du sie nicht mehr brauchst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the last member. Archive the group if you don't need it anymore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el último miembro. Archiva el grupo si ya no lo necesitas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes le dernier membre. Archivez le groupe si vous n'en avez plus besoin"
