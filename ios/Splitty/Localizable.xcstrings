    "На месяц": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensual"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatlich"
