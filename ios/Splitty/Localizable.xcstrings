            "value": "リンクまたはコードを共有してください。友だちは「参加する」から参加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享链接或邀请码 — 好友可通过「加入」进群。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크나 코드를 공유해 주십시오. 친구는 「참여하기」로 들어옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
