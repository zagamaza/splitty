            "value": "Gedrückt halten und sprechen; nach oben wischen zum Fixieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold and speak; swipe up to lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado y habla; desliza arriba para fijar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez et parlez ; balayez vers le haut pour verrouiller"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте и говорите; свайп вверх — закрепить"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したまま話してください。上へスワイプで固定します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话；上滑锁定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 채 말씀하십시오. 위로 밀면 고정됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure e fale; deslize para cima para travar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto e parla; scorri in alto per bloccare"
          }
        }
      }
    },
    "Удерживайте и скажите, что изменить": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
