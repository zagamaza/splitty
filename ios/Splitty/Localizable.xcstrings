        }
      }
    },
    "Любым из привязанных способов можно войти в этот же аккаунт.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jeder verknüpften Methode landest du im selben Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any linked method signs you in to this same account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera de estas formas te lleva a esta misma cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe lequel de ces modes vous connecte au même compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любым из привязанных способов можно войти в этот же аккаунт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携したどの方法でも、この同じアカウントにサインインできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
