    "Вам вернули долг": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat dir Geld zurückgezahlt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone paid you back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien te devolvió dinero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un vous a remboursé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам вернули долг"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返済を受けました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人还了你钱"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빚을 돌려받았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagaram sua dívida"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti hanno restituito un debito"
          }
        }
      }
    },
    "Вам вернули долг, и напоминания о ваших долгах": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schuld wurde dir zurückgezahlt, dazu Erinnerungen an deine eigenen Schulden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A debt was repaid to you, plus reminders about your own debts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han devuelto una deuda, y recordatorios de las tuyas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dette vous a été remboursée, et rappels de vos propres dettes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам вернули долг, и напоминания о ваших долгах"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返済を受けたとき、およびあなたの借りについてのお知らせ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人还款给你，以及关于你欠款的提醒"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빚을 돌려받았을 때와 회원님의 빚에 대한 알림"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém pagou o que devia a você, e lembretes das suas dívidas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un debito ti è stato restituito, più i promemoria sui tuoi debiti"
          }
        }
      }
    },
    "Вам должны": {
