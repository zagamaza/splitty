    "Группа исчезнет из вашего списка. Вернуться можно только по приглашению участника": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe verschwindet aus deiner Liste. Zurück kommst du nur, wenn dich ein Mitglied einlädt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group disappears from your list. You can only come back if a member invites you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo desaparece de tu lista. Solo puedes volver si un miembro te invita"
