    "Поездка, квартира, ужин — кто за что заплатил": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reise, Wohnung, Abendessen — wer hat was bezahlt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip, a flat, a dinner — who paid for what"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje, un piso, una cena: quién pagó qué"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage, un appartement, un dîner — qui a payé quoi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка, квартира, ужин — кто за что заплатил"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行・シェアハウス・食事 — 誰が何を支払ったか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、合租、晚餐 — 谁为什么付了钱"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행, 셰어하우스, 저녁 — 누가 무엇을 결제했는가"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Viagem, apartamento, jantar — quem pagou o quê"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viaggio, appartamento, cena: chi ha pagato cosa"
          }
        }
      }
    },
    "Поездка, общая квартира или один ужин — всё, что вы с кем-то делите": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reise, eine WG oder ein Abendessen — alles, was du mit jemandem teilst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip, a shared flat or a single dinner — anything you split with someone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje, un piso compartido o una cena: cualquier cosa que compartas con alguien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage, une colocation ou un dîner — tout ce que vous partagez avec quelqu’un"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка, общая квартира или один ужин — всё, что вы с кем-то делите"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、シェアハウス、1回の食事 — 誰かと分け合うものすべて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、合租房或一顿晚餐 — 任何你和别人分摊的开销"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행, 셰어하우스, 한 번의 저녁 — 누군가와 나누는 모든 것"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem, um apartamento compartilhado ou um único jantar — tudo o que você divide com alguém"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaggio, un appartamento condiviso o una sola cena: tutto quello che dividi con qualcuno"
          }
        }
      }
    },
    "Поездка, съёмная квартира или один ужин. Платит кто-то один, а расход делят все.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reise, eine Mietwohnung oder ein Abendessen. Einer zahlt, alle teilen sich die Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip, a rented flat or a single dinner. One person pays, everyone shares the expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje, un piso alquilado o una cena. Paga uno y el gasto se reparte entre todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage, un appartement loué ou un dîner. Une personne paie, tout le monde partage la dépense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка, съёмная квартира или один ужин. Платит кто-то один, а расход делят все."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、賃貸の部屋、1回の食事。誰か1人が支払い、支出は全員で分けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、租房或一顿晚餐。一个人付款，所有人分摊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행, 임대한 집, 한 번의 저녁. 한 사람이 결제하고 모두가 나눕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem, um apartamento alugado ou um jantar. Uma pessoa paga e todos dividem a despesa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaggio, un appartamento in affitto o una cena. Paga una persona e la spesa la dividono tutti."
          }
        }
      }
    },
    "Позвать можно того, с кем уже была общая группа. Нового человека — по ссылке или коду приглашения": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladen kannst du, mit wem du schon eine Gruppe geteilt hast. Eine neue Person — per Link oder Einladungscode"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can invite someone you’ve already shared a group with. A new person — by link or invite code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes invitar a alguien con quien ya compartiste grupo. A una persona nueva, por enlace o código de invitación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez inviter quelqu’un avec qui vous avez déjà partagé un groupe. Une nouvelle personne — par lien ou code d’invitation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позвать можно того, с кем уже была общая группа. Нового человека — по ссылке или коду приглашения"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに同じグループにいた人を招待できます。新しい人はリンクまたは招待コードで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以邀请已经同群的人。新朋友请用链接或邀请码"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 같은 그룹에 있던 분을 초대할 수 있습니다. 새로운 분은 링크나 초대 코드로 초대하십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para convidar quem já esteve em um grupo com você. Alguém novo — por link ou código de convite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi invitare chi ha già condiviso un gruppo con te. Una persona nuova con un link o un codice d’invito"
          }
        }
      }
    },
