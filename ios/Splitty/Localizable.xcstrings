    "Операций с вами нет": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Vorgänge mit dir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing involving you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en lo que participes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune opération vous concernant"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операций с вами нет"
          }
        },
        "ja": {
