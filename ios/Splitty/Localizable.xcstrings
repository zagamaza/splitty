          }
        }
      }
    },
    "Укажите цену — коснитесь позиции с меткой «цена?». Или продиктуйте: «пицца стоила 600»": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Preis an — tippe auf die Position mit „Preis?“. Oder sag es einfach: „die Pizza hat 600 gekostet“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a price — tap the item marked “price?”. Or just say it: “the pizza was 600”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un precio: toca la línea marcada con «¿precio?». O dilo en voz alta: «la pizza costó 600»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un prix — touchez la ligne marquée « prix ? ». Ou dictez : « la pizza coûtait 600 »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите цену — коснитесь позиции с меткой «цена?». Или продиктуйте: «пицца стоила 600»"
          }
        }
      }
    },
    "Укажите цены позиций — без них не посчитать доли": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Preise für die Positionen an — ohne sie lassen sich die Anteile nicht berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add prices for the items — without them the shares can’t be worked out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica los precios de las líneas: sin ellos no se pueden calcular las partes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez les prix des lignes — sans eux, impossible de calculer les parts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите цены позиций — без них не посчитать доли"
          }
        }
      }
    },
