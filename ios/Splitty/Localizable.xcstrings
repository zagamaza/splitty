    "Расход сохранён — отправим, когда появится связь": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe gespeichert — wir senden sie, sobald wieder Verbindung besteht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expense saved — we’ll send it once you’re back online"
          }
        },
        "es": {
