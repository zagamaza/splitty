    "Войти по паролю больше не получится. Адрес останется за аккаунтом.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich dann nicht mehr mit Passwort anmelden. Die Adresse bleibt beim Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be able to sign in with a password any more. The address stays with the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrás entrar con contraseña. El correo seguirá asociado a la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus vous connecter par mot de passe. L’adresse restera liée au compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти по паролю больше не получится. Адрес останется за аккаунтом."
          }
        }
      }
    },
    "Войти через %@ больше не получится. Остальные способы входа продолжат работать.": {
