    "В этой группе накопилось слишком много расходов. Заведите новую — старая останется доступной для чтения": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Gruppe haben sich zu viele Ausgaben angesammelt. Lege eine neue an — die alte bleibt lesbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group has piled up too many expenses. Start a new one — the old one stays readable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo acumula demasiados gastos. Crea uno nuevo: el antiguo seguirá disponible para leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe a accumulé trop de dépenses. Créez-en un nouveau — l’ancien restera consultable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой группе накопилось слишком много расходов. Заведите новую — старая останется доступной для чтения"
          }
        }
      }
    },
