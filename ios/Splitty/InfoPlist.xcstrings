{
  "sourceLanguage": "ru",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird gebraucht, um den Beleg zu fotografieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is needed to photograph a receipt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para fotografiar el recibo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert à photographier le ticket"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы сфотографировать чек"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wird gebraucht, um Ausgaben per Sprache zu diktieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is needed to dictate an expense by voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se usa para dictar los gastos por voz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro sert à dicter une dépense à la voix"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон нужен, чтобы надиктовать расход голосом"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Fotos wird gebraucht, um ein Beleg-Foto auszuwählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to photos is needed to pick a photo of a receipt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a las fotos se usa para elegir la foto del recibo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux photos sert à choisir une photo de ticket"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к фото нужен, чтобы выбрать фото чека"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung zeigt den Text des Diktats schon während der Aufnahme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition shows the text of your dictation while you record"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz muestra el texto del dictado mientras grabas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale affiche le texte de la dictée pendant l’enregistrement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи показывает текст надиктовки прямо во время записи"
          }
        }
      }
    }
  },
  "version": "1.0"
}
